# --- Core ---
DATABASE_URL=postgres://cloudpoc:cloudpoc@localhost:5432/cloudpoc
DB_POOL_MAX=20
APP_BASE_URL=http://localhost:3000
BRAND_NAME="Umniah Cloud"
# 32+ random bytes, e.g.  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Set to "false" only for local http testing; keep true behind TLS
COOKIE_SECURE=false

# --- Integrations (mock | http) ---
CRM_MODE=mock
CRM_BASE_URL=
CRM_API_KEY=
PRICE_CACHE_TTL_SECONDS=60

PAYMENT_MODE=mock
PAYMENT_GATEWAY_URL=
PAYMENT_HMAC_SECRET=change-me-gateway-hmac-secret-32-chars-min

PROVISIONING_MODE=mock
PROVISIONING_BASE_URL=
PROVISIONING_API_KEY=

# --- Worker ---
WORKER_ENABLED=true
WORKER_INTERVAL_MS=3000

# --- Seed admin ---
SEED_ADMIN_EMAIL=admin@cloud.local
SEED_ADMIN_PASSWORD="Admin#2026!"
